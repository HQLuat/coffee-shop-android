<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Order Code -->
        <TextView
            android:id="@+id/tvOrderCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="#ORD12345"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvOrderStatus" />

        <!-- Order Status -->
        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang chờ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/orange"
            android:background="@drawable/status_badge"
            android:padding="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Customer Email -->
        <TextView
            android:id="@+id/tvCustomerEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="customer@email.com"
            android:textSize="14sp"
            android:textColor="@color/grey"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/tvOrderCode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Order Date -->
        <TextView
            android:id="@+id/tvOrderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="13/01/2026 14:30"
            android:textSize="13sp"
            android:textColor="@color/grey"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@drawable/ic_calendar"
            app:drawableTint="@color/grey"
            app:layout_constraintTop_toBottomOf="@id/tvCustomerEmail"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Item Count -->
        <TextView
            android:id="@+id/tvItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 sản phẩm"
            android:textSize="13sp"
            android:textColor="@color/grey"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@drawable/ic_shopping_bag"
            app:drawableTint="@color/grey"
            app:layout_constraintTop_toTopOf="@id/tvOrderDate"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/grey"
            app:layout_constraintTop_toBottomOf="@id/tvOrderDate" />

        <!-- Payment Status -->
        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đã thanh toán"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/holo_green_dark"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Order Amount -->
        <TextView
            android:id="@+id/tvOrderAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150,000₫"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brown"
            app:layout_constraintTop_toTopOf="@id/tvPaymentStatus"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end"
            app:layout_constraintTop_toBottomOf="@id/tvPaymentStatus">

            <Button
                android:id="@+id/btnUpdateStatus"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cập nhật"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/brown"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Xóa"
                android:textSize="12sp"
                android:textColor="@color/red"
                android:backgroundTint="@android:color/transparent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/red" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>